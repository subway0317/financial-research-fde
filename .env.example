# Set a real organization/contact identity before live SEC requests.
SEC_USER_AGENT="FinancialResearch your-name your-email@example.com"
HTTP_TIMEOUT_SECONDS=30
MARKET_LOOKBACK_DAYS=730
STALE_MARKET_DAYS=7
# Required for live Agent / frozen-fixture eval. No default model; use shell exports.
OPENAI_API_KEY=
OPENAI_MODEL=
# Positive, finite seconds; independent of financial provider HTTP_TIMEOUT_SECONDS.
OPENAI_TIMEOUT_SECONDS=120
# Optional Judge/calibration model; empty/unset uses OPENAI_MODEL.
# Judge-v2 live benchmark requires successful same-model, same-manifest calibration first.
OPENAI_EVAL_MODEL=
# Preregistered ceiling, measured with complete market/fundamental evidence closures.
MAX_SYNTHESIS_PAYLOAD_BYTES=200000
# Stage 8: existing api.app stays the unprotected local development entrypoint.
# The deployment entrypoint defaults to production; Render sets it explicitly.
APP_ENV=development
LOG_LEVEL=INFO
# Set a private, random access code in Render; never use a VITE variable.
DEMO_ACCESS_TOKEN=
